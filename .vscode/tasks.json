{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "LoyaltySim: activate venv on open",
      "type": "shell",
      "command": "Write-Host 'LoyaltySim venv active — python:' (Get-Command python).Source",
      "options": {
        "cwd": "${workspaceFolder}",
        "shell": {
          "executable": "powershell.exe",
          "args": [
            "-NoExit",
            "-ExecutionPolicy",
            "Bypass",
            "-Command",
            "& '${workspaceFolder}\\venv\\Scripts\\Activate.ps1'; Write-Host 'LoyaltySim venv active — python:' (Get-Command python).Source"
          ]
        }
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "focus": false
      },
      "runOptions": {
        "runOn": "folderOpen"
      },
      "problemMatcher": []
    }
  ]
}
